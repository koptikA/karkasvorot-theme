		{ "step": "defineWpConfigConsts", "consts": { "WP_DEBUG": true, "WP_DEBUG_DISPLAY": true } },
		{ "step": "setSiteLanguage", "language": "ru_RU" },
		{ "step": "setSiteOptions", "options": { "permalink_structure": "/%postname%/" } }
	]
}
